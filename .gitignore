# Dependencies and build output
node_modules/
dist/
src-tauri/target/
# Generated by tauri-build from the capabilities
src-tauri/gen/

# Editors and OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ─── Secrets & signing material - MUST NEVER be committed ───
# Credentials live in Windows Credential Manager at runtime, never on disk,
# but this is a defense-in-depth net against accidental key exports.
*.key
*.pem
*private*key*
*PrivateKey*
*.p12
*.pfx
*.cer
*.cert
.env
.env.*
*.netrc
