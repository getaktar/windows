# Dependencies and build output
node_modules/
dist/
src-tauri/target/
# Generated by tauri-build from the capabilities
src-tauri/gen/

# Editors and OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ─── Secrets & signing material - MUST NEVER be committed ───
# Credentials live in Windows Credential Manager at runtime, never on disk,
# but this is a defense-in-depth net against accidental key exports.
*.key
*.pem
*private*key*
*PrivateKey*
*.p12
*.pfx
*.pvk
*.spc
*.snk
*.cer
*.cert
*.crt
*.jks
.env
.env.*
*.netrc
# Tauri's updater signing key (tauri signer generate): the public half is
# in tauri.conf.json, the private half only in the release secret.
.tauri/

# Partner Center / Store CLI state and packages built outside
# src-tauri/target (scripts/pack_msix.ps1 writes there by default).
.msstore/
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
